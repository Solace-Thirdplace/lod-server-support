+    /** Keep Sodium's donation controls usable when the extended tab row reaches them.
+     * Each rebuild creates new widgets; move only a colliding pair to the free footer,
+     * without changing Sodium's saved donation preference. All optional internals remain
+     * reflective and contained so an unsupported screen still opens normally. */
+    public static void fitDonationButtons(Object target) {
+        try {
+            Screen screen = (Screen) target;
+            Object donate = screenField(target, "donateButton"), dismiss = screenField(target, "hideDonateButton");
+            Object donationDim = screenField(donate, "dim");
+            int dx = dimension(donationDim, "x"), dy = dimension(donationDim, "y");
+            boolean overlaps = false;
+            for (Object child : screen.children()) {
+                if (child == donate || child == dismiss || !child.getClass().getSimpleName().equals("FlatButtonWidget")) continue;
+                Object bounds = screenField(child, "dim");
+                if (dimension(bounds, "y") == dy && dimension(bounds, "x") < dx
+                        && dimension(bounds, "x") + dimension(bounds, "width") > dx) overlaps = true;
+                if (dimension(bounds, "y") == dy && dimension(bounds, "x") >= dx) overlaps = true;
+            }
+            if (!overlaps) return;
+            int left = 6, y = screen.height - 30;
+            int donationWidth = dimension(donationDim, "width");
+            int dismissWidth = dimension(screenField(dismiss, "dim"), "width");
+            if (left + donationWidth + 4 + dismissWidth > screen.width - 211) {
+                // Extremely narrow screens have no free footer. Hide this rebuild only.
+                donate.getClass().getMethod("setVisible", boolean.class).invoke(donate, false);
+                dismiss.getClass().getMethod("setVisible", boolean.class).invoke(dismiss, false);
+                return;
+            }
+            moveButton(donate, left, y);
+            moveButton(dismiss, left + donationWidth + 4, y);
+        } catch (Throwable failure) {
+            warnOnce("could not fit Sodium's donation controls", failure);
+        }
+    }
+
+    private static int dimension(Object bounds, String name) throws ReflectiveOperationException {
+        return (int) bounds.getClass().getMethod(name).invoke(bounds);
+    }
+
+    private static Object screenField(Object target, String name) throws ReflectiveOperationException {
