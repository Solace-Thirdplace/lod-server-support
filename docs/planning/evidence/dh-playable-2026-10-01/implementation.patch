+package dev.vox.lss.common.dh;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class DhSessionPolicyTest {
+    @Test void zeroTimestampSnapshotsStillRefreshAfterTheUntouchedFrontier() {
+        var p=new DhSessionPolicy(); var fresh=new DhPosition(6,0,0); var missing=new DhPosition(6,1,0);
+        assertEquals(0,p.acquisitionPriority(fresh));
+        p.accepted(fresh,1,1,0,0,120_000_000_000L);
+        assertEquals(2,p.acquisitionPriority(fresh));
+        p.cooldown(fresh,0); assertEquals(2,p.acquisitionPriority(fresh));
+        p.cooldown(missing,0); assertEquals(1,p.acquisitionPriority(missing));
+        assertEquals(0,p.acquisitionPriority(new DhPosition(6,2,0)));
+    }
+    @Test void theAcquisitionFrontierFillsEvenWhenNearbyReceiptsRefreshEarlier() {
+        var p=new DhSessionPolicy(); var order=new java.util.ArrayList<DhPosition>();
+        for(int ring=0;ring<=8;ring++) for(int x=-ring;x<=ring;x++) for(int z=-ring;z<=ring;z++)
+            if(Math.max(Math.abs(x),Math.abs(z))==ring) order.add(new DhPosition(6,x,z));
+        var acquired=new java.util.HashSet<DhPosition>();
+        for(int second=0;second<order.size();second++) {
+            long now=second*1_000_000_000L; DhPosition chosen=null;
+            for(int priority=0;priority<3 && chosen==null;priority++) for(var tile:order)
+                if(p.acquisitionPriority(tile)==priority && p.due(tile,now)) { chosen=tile; break; }
+            assertNotNull(chosen); assertTrue(acquired.add(chosen),"No refresh can starve an untouched tile");
+            p.accepted(chosen,0xffff,0xffff,second,now,120_000_000_000L);
+        }
+        assertEquals(order.size(),acquired.size());
+    }
+    @Test void pluginBordersUseBlocksWhileOfficialBordersUseChunks() {
+        var tile=new DhPosition(6,16,0); // center (66,2) chunks == (1056,32) blocks
+        assertTrue(DhSessionPolicy.inBorder(DhProfile.SUPPORT_15,tile,1024,0,256));
+        assertFalse(DhSessionPolicy.inBorder(DhProfile.SUPPORT_15,tile,0,0,256));
+        assertTrue(DhSessionPolicy.inBorder(DhProfile.OFFICIAL_16,tile,64,0,16));
+        assertFalse(DhSessionPolicy.inBorder(DhProfile.OFFICIAL_16,tile,1024,0,256));
+        assertTrue(DhSessionPolicy.inBorder(DhProfile.SUPPORT_15,tile,0,0,0));
+    }
+    @Test void vanillaAuthoritySurvivesRefreshAndReceiptReset() {
+        var p=new DhSessionPolicy();
+        p.vanilla(-1,8);
+        assertFalse(p.eligible(-1,8)); assertTrue(p.eligible(8,-1));
+        var tile=new DhPosition(6,0,0);
+        p.accepted(tile,1,1,99,0,120_000_000_000L);
+        assertFalse(p.due(tile,1));
+        p.clearReceipts(); assertFalse(p.eligible(-1,8));
+        assertTrue(p.due(tile,1)); assertEquals(0,p.timestamp(tile));
+    }
+    @Test void OneFailedColumnCannotMakeTheTileFresh() {
+        var p=new DhSessionPolicy(); var tile=new DhPosition(6,-1,0);
+        assertFalse(p.accepted(tile,0xffff,0xfffe,1234,0,120_000_000_000L));
+        assertEquals(0,p.timestamp(tile));
+        assertFalse(p.due(tile,29_999_999_999L)); assertTrue(p.due(tile,30_000_000_000L));
+    }
+    @Test void onlyEligibleColumnsCountAndAllVanillaDoesNotCreateAReceipt() {
+        var p=new DhSessionPolicy(); var tile=new DhPosition(6,0,0);
+        assertFalse(p.accepted(tile,0,0,12,0,100)); assertEquals(0,p.timestamp(tile));
+        assertTrue(p.accepted(tile,0x8001,0x8001,12,40_000_000_000L,100));
+        assertEquals(12,p.timestamp(tile)); assertFalse(p.due(tile,40_000_000_099L));
+        assertTrue(p.due(tile,40_000_000_100L));
+    }
+    @Test void absenceMayScheduleGenerationButRefusalPreservesPriorReceipt() {
+        var p=new DhSessionPolicy(); var tile=new DhPosition(6,0,0);
+        p.absent(tile,0,true); assertTrue(p.generationNeeded(tile));
+        assertFalse(p.due(tile,1_999_999_999L)); assertTrue(p.due(tile,2_000_000_000L));
+        p.accepted(tile,1,1,18,3_000_000_000L,100);
+        p.cooldown(tile,4_000_000_000L); assertEquals(18,p.timestamp(tile));
+        assertFalse(p.generationNeeded(tile));
+    }
+}
