@@ -0,0 +1,12 @@
+package dev.vox.lss.common.dh;
+
+/** Family matters as well as protocol: DH Support prefixes UTF-8 strings with UTF-16 length. */
+public enum DhProfile {
+    SUPPORT_15(15, true), OFFICIAL_15(15, false), OFFICIAL_16(16, false);
+    private final int version;
+    private final boolean support;
+    DhProfile(int version, boolean support) { this.version = version; this.support = support; }
+    public int version() { return version; }
+    public boolean support() { return support; }
+    public boolean regenerationFlag() { return version == 16; }
+}
diff --git a/common/src/main/java/dev/vox/lss/common/dh/DhProtocolCodec.java b/common/src/main/java/dev/vox/lss/common/dh/DhProtocolCodec.java
new file mode 100644
index 00000000..3821d457
--- /dev/null
+++ b/common/src/main/java/dev/vox/lss/common/dh/DhProtocolCodec.java
@@ -0,0 +1,159 @@
+package dev.vox.lss.common.dh;
+
+import java.io.ByteArrayOutputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import static dev.vox.lss.common.dh.DhMessage.*;
+
+/** Independent positional wire implementation. A mismatched header is never parsed using another profile. */
+public final class DhProtocolCodec {
+    public static final String CHANNEL = "distant_horizons:msg";
+    private final DhProfile profile;
+    private final DhLimits limits;
+    public DhProtocolCodec(DhProfile profile, DhLimits limits) {
+        this.profile = java.util.Objects.requireNonNull(profile);
+        this.limits = java.util.Objects.requireNonNull(limits);
+    }
+    /** Production queue boundary: retain this lease until the message is consumed or discarded.
+     * The reservation covers the frame, copied fragment/string bytes, beacon objects and parse temporaries.
+     */
+    public OwnedMessage decodeOwned(byte[] frame, DhMemoryBudget budget) throws DhCodecException {
+        if (frame.length > limits.frameBytes()) throw DhInput.limit("DH frame exceeds limit");
+        var lease = budget.reserve(frame.length * 4L + 512);
+        try { return new OwnedMessage(decode(frame), lease); }
+        catch (DhCodecException | RuntimeException | Error e) { lease.close(); throw e; }
+    }
+    public static final class OwnedMessage implements AutoCloseable {
+        private DhMessage message;
+        private final DhMemoryBudget.Lease lease;
+        private OwnedMessage(DhMessage message, DhMemoryBudget.Lease lease) { this.message = message; this.lease = lease; }
+        public DhMessage message() {
+            if (message == null) throw new IllegalStateException("DH message ownership released");
+            return message;
+        }
+        @Override public void close() { message = null; lease.close(); }
+    }
+    /** Per-frame parsing for tests/short synchronous use. Retained production messages use decodeOwned. */
+    public DhMessage decode(byte[] frame) throws DhCodecException {
+        if (frame.length > limits.frameBytes()) throw DhInput.limit("DH frame exceeds limit");
+        var in = new DhInput(frame);
+        int version = in.u16();
+        if (version != profile.version())
+            throw new DhCodecException(DhCodecException.Kind.PROTOCOL_MISMATCH, "DH protocol " + version
+                    + " differs from selected " + profile.version());
+        DhMessage result = switch (in.u16()) {
+            case 1 -> new CloseReason(text(in));
+            case 2 -> new LevelInit(text(in), text(in), text(in), in.i64());
+            case 3 -> new RequestLevelInit(text(in));
+            case 4 -> config(in);
+            case 5 -> new Cancel(in.i32());
+            case 6 -> new Refusal(in.i32(), in.i32(), text(in));
+            case 7 -> new Request(in.i32(), text(in), DhPosition.unpack(in.i64()), in.bool() ? in.i64() : null);
+            case 8 -> {
+                int request = in.i32();
+                yield in.bool() ? new Response(request, in.i32(), beacons(in))
+                        : new Response(request, null, List.of());
+            }
+            case 9 -> new PartialUpdate(text(in), in.i32(), beacons(in));
+            case 10 -> {
+                int buffer = in.i32(), length = in.i32();
+                if (length <= 0) throw DhInput.malformed("Invalid DH fragment length");
+                if (length > limits.tileBytes()) throw DhInput.limit("DH fragment length exceeds limit");
+                in.require(length + 1);
+                // Split owns one defensive copy. The temporary cursor copy is bounded by frameBytes.
+                byte[] bytes = in.take(length);
+                yield new Split(buffer, bytes, in.bool());
+            }
+            default -> throw new DhCodecException(DhCodecException.Kind.UNSUPPORTED, "Unknown DH message");
+        };
+        in.exhausted();
+        return result;
+    }
+    private String text(DhInput in) throws DhCodecException { return in.string(profile, limits.stringBytes()); }
+    private SessionConfig config(DhInput in) throws DhCodecException {
+        GeneratorPlan plan;
+        if (profile.version() == 15) plan = in.bool() ? GeneratorPlan.CHUNKS_ONLY : GeneratorPlan.DISABLED;
+        else {
+            int value = in.u8();
+            if (value >= GeneratorPlan.values().length) throw DhInput.malformed("Unknown generator plan");
+            plan = GeneratorPlan.values()[value];
+        }
+        try {
+            return new SessionConfig(plan, in.i32(), in.i32(), in.i32(), in.i32(), in.i32(),
+                    in.bool(), in.i32(), in.bool(), in.i32(), in.i32(), in.i32());
+        } catch (IllegalArgumentException e) { throw DhInput.malformed("Invalid session limits"); }
+    }
+    private List<Beacon> beacons(DhInput in) throws DhCodecException {
+        int count = in.i32();
+        if (count < 0 || count > 4096 || count > in.remaining() / 16)
+            throw DhInput.malformed("Invalid beacon count");
+        var result = new ArrayList<Beacon>(count);
+        for (int i = 0; i < count; i++) result.add(new Beacon(in.i32(), in.i32(), in.i32(), in.i32()));
+        return result;
+    }
+    public byte[] encode(DhMessage message) throws DhCodecException {
+        if (profile.support() && message instanceof CloseReason)
+            throw new DhCodecException(DhCodecException.Kind.UNSUPPORTED, "DH Support does not accept CloseReason");
+        if (message instanceof Split split && (split.length() < 1
+                || split.length() > Math.min(limits.tileBytes(), limits.frameBytes() - 13)))
+            throw DhInput.limit("DH fragment exceeds frame limit");
+        var bytes = new ByteArrayOutputStream();
+        try (var out = new DataOutputStream(bytes)) {
+            out.writeShort(profile.version());
+            switch (message) {
+                case CloseReason m -> { out.writeShort(1); text(out, m.reason()); }
+                case LevelInit m -> { out.writeShort(2); text(out, m.dimension()); text(out, m.serverKey());
+                    text(out, m.levelKey()); out.writeLong(m.serverTime()); }
+                case RequestLevelInit m -> { out.writeShort(3); text(out, m.dimension()); }
+                case SessionConfig m -> {
+                    out.writeShort(4);
+                    if (profile.version() == 15) {
+                        if (m.plan() != GeneratorPlan.CHUNKS_ONLY && m.plan() != GeneratorPlan.DISABLED)
+                            throw new DhCodecException(DhCodecException.Kind.UNSUPPORTED, "Protocol 15 uses a generation boolean");
+                        out.writeBoolean(m.plan() != GeneratorPlan.DISABLED);
+                    } else out.writeByte(m.plan().ordinal());
+                    out.writeInt(m.generationDistance()); out.writeInt(m.centerX()); out.writeInt(m.centerZ());
+                    out.writeInt(m.borderRadius()); out.writeInt(m.generationRate()); out.writeBoolean(m.updates());
+                    out.writeInt(m.updateDistance()); out.writeBoolean(m.synchronize()); out.writeInt(m.syncDistance());
+                    out.writeInt(m.syncRate()); out.writeInt(m.bandwidthKB());
+                }
+                case Cancel m -> { out.writeShort(5); out.writeInt(m.requestId()); }
+                case Refusal m -> { out.writeShort(6); out.writeInt(m.requestId()); out.writeInt(m.reason()); text(out, m.message()); }
+                case Request m -> { out.writeShort(7); out.writeInt(m.requestId()); text(out, m.level());
+                    out.writeLong(m.position().packed()); out.writeBoolean(m.timestamp() != null);
+                    if (m.timestamp() != null) out.writeLong(m.timestamp()); }
+                case Response m -> {
+                    out.writeShort(8); out.writeInt(m.requestId()); out.writeBoolean(m.bufferId() != null);
+                    if (m.bufferId() != null) { out.writeInt(m.bufferId()); beacons(out, m.beacons()); }
+                    else if (!m.beacons().isEmpty()) throw DhInput.malformed("Beacons without a response payload");
+                }
+                case PartialUpdate m -> { out.writeShort(9); text(out, m.level()); out.writeInt(m.bufferId()); beacons(out, m.beacons()); }
+                case Split m -> { out.writeShort(10); out.writeInt(m.bufferId()); out.writeInt(m.length());
+                    out.write(m.contents()); out.writeBoolean(m.first()); }
+            }
+        } catch (DhCodecException e) { throw e; }
+        catch (IOException e) { throw new DhCodecException(DhCodecException.Kind.MALFORMED, "Cannot encode DH frame", e); }
+        if (bytes.size() > limits.frameBytes()) throw DhInput.limit("DH frame exceeds limit");
+        return bytes.toByteArray();
+    }
+    private void text(DataOutputStream out, String value) throws IOException {
+        if (value.length() > limits.stringBytes()) throw DhInput.limit("DH string exceeds limit");
+        // UTF-8 encoders otherwise silently replace isolated surrogates.
+        for (int i = 0; i < value.length(); i++) if (Character.isSurrogate(value.charAt(i))) {
+            if (!Character.isHighSurrogate(value.charAt(i)) || i + 1 == value.length()
+                    || !Character.isLowSurrogate(value.charAt(++i))) throw DhInput.malformed("Invalid Unicode string");
+        }
+        byte[] data = value.getBytes(StandardCharsets.UTF_8);
+        if (data.length > limits.stringBytes()) throw DhInput.limit("DH string exceeds byte limit");
+        out.writeShort(profile.support() ? value.length() : data.length);
+        out.write(data);
+    }
+    private void beacons(DataOutputStream out, List<Beacon> values) throws IOException {
+        if (values.size() > 4096) throw DhInput.limit("Too many beacons");
+        out.writeInt(values.size());
+        for (var b : values) { out.writeInt(b.x()); out.writeInt(b.y()); out.writeInt(b.z()); out.writeInt(b.rgb()); }
+    }
+}
diff --git a/common/src/main/java/dev/vox/lss/common/dh/DhSessionPolicy.java b/common/src/main/java/dev/vox/lss/common/dh/DhSessionPolicy.java
new file mode 100644
index 00000000..015de05d
--- /dev/null
+++ b/common/src/main/java/dev/vox/lss/common/dh/DhSessionPolicy.java
@@ -0,0 +1,46 @@
+package dev.vox.lss.common.dh;
+
+import java.util.*;
+
+/** Session-only freshness and vanilla authority. Caller owns the client thread. */
+public final class DhSessionPolicy {
+    private final Set<Long> vanilla = new HashSet<>();
+    private final LinkedHashMap<DhPosition, Receipt> receipts = new LinkedHashMap<>();
+    private record Receipt(long timestamp, long due, boolean generate, boolean snapshot) {}
+    public void vanilla(int x, int z) {
+        if (vanilla.size() >= 262_144 && !vanilla.contains(column(x,z)))
+            throw new IllegalStateException("DH vanilla authority limit reached; reconnect to resume");
+        vanilla.add(column(x,z));
+    }
+    public boolean eligible(int x, int z) { return !vanilla.contains(column(x,z)); }
+    /** Untouched frontier first, then incomplete retries, then accepted refreshes. */
+    public int acquisitionPriority(DhPosition p) {
+        var receipt=receipts.get(p); return receipt==null?0:receipt.snapshot?2:1;
+    }
+    private boolean snapshot(DhPosition p) { var r=receipts.get(p); return r!=null && r.snapshot; }
+    public boolean due(DhPosition p, long now) { return !receipts.containsKey(p) || receipts.get(p).due <= now; }
+    public long timestamp(DhPosition p) { var r=receipts.get(p); return r==null ? 0 : r.timestamp; }
+    public boolean generationNeeded(DhPosition p) { var r=receipts.get(p); return r!=null && r.generate; }
+    public void absent(DhPosition p, long now, boolean generationAllowed) {
+        put(p, new Receipt(timestamp(p), now + (generationAllowed ? 2_000_000_000L : 120_000_000_000L), generationAllowed,snapshot(p)));
+    }
+    public void cooldown(DhPosition p, long now) { put(p,new Receipt(timestamp(p),now+30_000_000_000L,false,snapshot(p))); }
+    /** Every eligible MC column must have been accepted. Skipping vanilla never invents a timestamp. */
+    public boolean accepted(DhPosition p, int eligibleMask, int acceptedMask, long timestamp, long now, long refresh) {
+        if (eligibleMask==0 || (acceptedMask & eligibleMask)!=eligibleMask) { cooldown(p,now); return false; }
+        put(p,new Receipt(timestamp,now+refresh,false,true)); return true;
+    }
+    public void clearReceipts() { receipts.clear(); }
+    /** DH Support advertises its Bukkit border in blocks; official DH uses chunks. */
+    public static boolean inBorder(DhProfile profile,DhPosition tile,int centerX,int centerZ,int radius) {
+        if(radius==0) return true;
+        long x=(long)tile.x()*4+2,z=(long)tile.z()*4+2;
+        if(profile.support()) { x*=16; z*=16; }
+        return Math.abs(x-centerX)<=radius && Math.abs(z-centerZ)<=radius;
+    }
+    private void put(DhPosition p, Receipt r) {
+        receipts.remove(p); receipts.put(p,r);
+        if (receipts.size()>4096) receipts.remove(receipts.keySet().iterator().next());
+    }
+    private static long column(int x,int z) { return (x & 0xffffffffL) | ((long)z<<32); }
+}
diff --git a/common/src/main/java/dev/vox/lss/common/dh/DhTerrainDecoder.java b/common/src/main/java/dev/vox/lss/common/dh/DhTerrainDecoder.java
new file mode 100644
index 00000000..2f6b0247
--- /dev/null
+++ b/common/src/main/java/dev/vox/lss/common/dh/DhTerrainDecoder.java
@@ -0,0 +1,287 @@
+package dev.vox.lss.common.dh;
+
+import com.github.luben.zstd.Zstd;
+import org.tukaani.xz.XZInputStream;
+import java.io.*;
+import java.util.*;
+import static dev.vox.lss.common.dh.DhTerrainTile.*;
+
+/** Independent format-1/2 decoder. The plan's wire description is the contract; no upstream linkage. */
+public final class DhTerrainDecoder {
+    private final DhLimits limits;
+    public DhTerrainDecoder(DhLimits limits) { this.limits = Objects.requireNonNull(limits); }
+
+    public DhTerrainTile decode(byte[] dto, DhProfile profile, DhPosition expected,
+                                WorldShape world, DhMemoryBudget budget) throws DhCodecException {
+        if (dto.length > limits.tileBytes() || world.height() > limits.worldHeight())
+            throw DhInput.limit("DH tile or world height exceeds limit");
+        var leases = new ArrayList<DhMemoryBudget.Lease>();
+        try {
+            hold(leases, budget, dto.length + 512L * 1024); // input plus column/lease tables and validation scratch
+            var in = new DhInput(dto);
+            DhPosition pos = DhPosition.unpack(in.i64());
+            if (!pos.equals(expected)) throw DhInput.malformed("Unexpected returned DH position");
+            if (pos.detail() != 6) throw unsupported("Only network-detail-6 terrain is supported");
+            int hash = in.i32();
+            var blobs = new Slice[8];
+            int compressed = 0;
+            for (int i = 0; i < blobs.length; i++) {
+                int size = in.i32();
+                if (size < 0) throw DhInput.malformed("Negative DH blob length");
+                if (size > limits.tileBytes() - compressed) throw DhInput.limit("DH blob exceeds tile budget");
+                in.require(size);
+                blobs[i] = new Slice(dto, in.offset, size);
+                in.offset += size;
+                compressed += size;
+            }
+            int format = in.u8(), mode = in.u8();
+            if (format != 1 && format != 2) throw unsupported("Unknown DH terrain format");
+            if (mode != 0 && mode != 3 && mode != 4) throw unsupported("DH compression mode is unsupported");
+            boolean parent = in.bool(), children = in.bool();
+            boolean regenerate = profile.regenerationFlag() && in.bool();
+            long firstTimestamp = in.i64(), secondTimestamp = in.i64();
+            // DH Support labels its slots created/updated; official DTOs use modified/created.
+            long modified = profile.support() ? secondTimestamp : firstTimestamp;
+            long created = profile.support() ? firstTimestamp : secondTimestamp;
+            in.exhausted();
+            var reads = new Reads(mode, profile.support(), budget);
+            List<DhMaterial> materials = mappings(blobs[7], reads, budget, leases);
+            byte[] generation = metadata(blobs[5], reads), compression = metadata(blobs[6], reads);
+            long[][] columns = new long[4096][];
+            var spans = new Counter();
+            if (format == 1) {
+                for (int i = 1; i <= 4; i++) if (blobs[i].size != 0)
+                    throw unsupported("Format 1 adjacent terrain is unsupported");
+                try (var stream = reads.open(blobs[0])) {
+                    for (int c = 0; c < 4096; c++) {
+                        int count = stream.data.readUnsignedShort();
+                        allocate(count, world, spans, budget, leases);
+                        columns[c] = new long[count];
+                        for (int i = 0; i < count; i++) columns[c][i] = stream.data.readLong();
+                    }
+                    stream.finish();
+                }
+            } else {
+                // Each blob has its own prediction state; x outer / z inner within each rectangle.
+                int[][] bounds = {{1,63,1,63}, {0,64,0,1}, {0,64,63,64}, {63,64,0,64}, {0,1,0,64}};
+                for (int b = 0; b < 5; b++) {
+                    if (blobs[b].size == 0) throw DhInput.malformed("Missing format-2 interior or edge blob");
+                    int[] rectangle = bounds[b];
+                    int[] indices = rectangle(rectangle);
+                    try (var stream = reads.open(blobs[b])) {
+                        long[][] local = new long[indices.length][];
+                        for (int c = 0; c < local.length; c++) {
+                            int count = varint(stream.data);
+                            if (count < 0) throw DhInput.malformed("Invalid column span count");
+                            allocate(count, world, spans, budget, leases);
+                            local[c] = new long[count];
+                        }
+                        for (long[] col : local) for (int i = 0; i < col.length; i++)
+                            col[i] = varint(stream.data) & 0xffffffffL;
+                        for (long[] col : local) for (int i = 0; i < col.length; i++) {
+                            int height = varint(stream.data);
+                            if (height < 1 || height > 4095) throw DhInput.malformed("Invalid format-2 height");
