--- /dev/null
+++ b/common/src/main/java/dev/vox/lss/common/dh/DhMemoryBudget.java
@@ -0,0 +1,33 @@
+package dev.vox.lss.common.dh;
+
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** Share one instance across assembly, decoding and retained tiles. Reserve BEFORE allocating. */
+public final class DhMemoryBudget {
+    private final long capacity;
+    private long used, peak;
+
+    public DhMemoryBudget(long capacity) {
+        if (capacity < 1) throw new IllegalArgumentException("Invalid memory capacity");
+        this.capacity = capacity;
+    }
+    public synchronized Lease reserve(long bytes) throws DhCodecException {
+        if (bytes < 0 || bytes > capacity - used)
+            throw new DhCodecException(DhCodecException.Kind.RESOURCE_LIMIT, "DH owned-memory budget exceeded");
+        used += bytes;
+        peak = Math.max(peak, used);
+        return new Lease(bytes);
+    }
+    public synchronized long used() { return used; }
+    public synchronized long peak() { return peak; }
+    public long capacity() { return capacity; }
+
+    public final class Lease implements AutoCloseable {
+        private final long bytes;
+        private final AtomicBoolean closed = new AtomicBoolean();
+        private Lease(long bytes) { this.bytes = bytes; }
+        @Override public void close() {
+            if (closed.compareAndSet(false, true)) synchronized (DhMemoryBudget.this) { used -= bytes; }
+        }
+    }
+}
diff --git a/common/src/main/java/dev/vox/lss/common/dh/DhMessage.java b/common/src/main/java/dev/vox/lss/common/dh/DhMessage.java
new file mode 100644
index 00000000..f4151873
--- /dev/null
+++ b/common/src/main/java/dev/vox/lss/common/dh/DhMessage.java
@@ -0,0 +1,46 @@
+package dev.vox.lss.common.dh;
+
+import java.util.List;
+
+/** Transport-neutral control messages. No upstream classes, arbitrary exception construction or MC types. */
+public sealed interface DhMessage {
+    record CloseReason(String reason) implements DhMessage {}
+    record LevelInit(String dimension, String serverKey, String levelKey, long serverTime) implements DhMessage {}
+    record RequestLevelInit(String dimension) implements DhMessage {}
+    enum GeneratorPlan { SURFACE_THEN_CHUNKS, SURFACE_ONLY, CHUNKS_ONLY, DISABLED }
+    record SessionConfig(GeneratorPlan plan, int generationDistance, int centerX, int centerZ, int borderRadius,
+                         int generationRate, boolean updates, int updateDistance, boolean synchronize,
+                         int syncDistance, int syncRate, int bandwidthKB) implements DhMessage {
+        public SessionConfig {
+            java.util.Objects.requireNonNull(plan);
+            if (generationDistance < 0 || borderRadius < 0 || generationRate < 0 || updateDistance < 0
+                    || syncDistance < 0 || syncRate < 0 || bandwidthKB < 0)
+                throw new IllegalArgumentException("Negative DH server limit");
+        }
+    }
+    record Cancel(int requestId) implements DhMessage {}
+    /** Reason IDs 0..3 are rate-limited, out-of-range, rejected, requires-splitting. Unknown IDs stay data. */
+    record Refusal(int requestId, int reason, String message) implements DhMessage {}
+    record Request(int requestId, String level, DhPosition position, Long timestamp) implements DhMessage {}
+    record Beacon(int x, int y, int z, int rgb) {}
+    record Response(int requestId, Integer bufferId, List<Beacon> beacons) implements DhMessage {
+        public Response { beacons = List.copyOf(beacons); }
+    }
+    /** Parsed for safe rejection/diagnostics; applying partial updates is outside the initial feature. */
+    record PartialUpdate(String level, int bufferId, List<Beacon> beacons) implements DhMessage {
+        public PartialUpdate { beacons = List.copyOf(beacons); }
+    }
+    final class Split implements DhMessage {
+        private final int bufferId;
+        private final byte[] bytes;
+        private final boolean first;
+        public Split(int bufferId, byte[] bytes, boolean first) {
+            this.bufferId = bufferId; this.bytes = bytes.clone(); this.first = first;
+        }
+        public int bufferId() { return bufferId; }
+        public byte[] bytes() { return bytes.clone(); }
+        public int length() { return bytes.length; }
+        public boolean first() { return first; }
+        byte[] contents() { return bytes; }
+    }
+}
diff --git a/common/src/main/java/dev/vox/lss/common/dh/DhPosition.java b/common/src/main/java/dev/vox/lss/common/dh/DhPosition.java
new file mode 100644
index 00000000..64685e0c
--- /dev/null
+++ b/common/src/main/java/dev/vox/lss/common/dh/DhPosition.java
@@ -0,0 +1,17 @@
+package dev.vox.lss.common.dh;
+
+/** DH coordinates have signed 28-bit axes. Network detail 6 denotes a 64-by-64 block tile. */
+public record DhPosition(int detail, int x, int z) {
+    public DhPosition {
+        if (detail < 0 || detail > 255 || x < -(1 << 27) || x >= 1 << 27
+                || z < -(1 << 27) || z >= 1 << 27)
+            throw new IllegalArgumentException("Unrepresentable DH position");
+    }
+    public static DhPosition tileForChunk(int x, int z) {
+        return new DhPosition(6, Math.floorDiv(x, 4), Math.floorDiv(z, 4));
+    }
+    public long packed() { return detail | ((x & 0xfffffffL) << 8) | ((z & 0xfffffffL) << 36); }
+    public static DhPosition unpack(long value) {
+        return new DhPosition((int) (value & 255), (int) (value << 28 >> 36), (int) (value >> 36));
+    }
+}
