+            policy=authority;
+            profile=switch(LSSClientConfig.CONFIG.snapshot().lod().dh().profile()) {
+                case "official_15" -> DhProfile.OFFICIAL_15;
+                case "official_16" -> DhProfile.OFFICIAL_16;
