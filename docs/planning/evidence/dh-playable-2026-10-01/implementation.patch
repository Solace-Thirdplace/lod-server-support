diff --git a/common/src/main/java/dev/vox/lss/common/dh/DhAssembly.java b/common/src/main/java/dev/vox/lss/common/dh/DhAssembly.java
new file mode 100644
index 00000000..8e59f15a
--- /dev/null
+++ b/common/src/main/java/dev/vox/lss/common/dh/DhAssembly.java
@@ -0,0 +1,143 @@
+package dev.vox.lss.common.dh;
+
+import java.util.*;
+import java.util.function.LongSupplier;
+import static dev.vox.lss.common.dh.DhMessage.*;
+
+/**
+ * Ordered, session-owned assembly. Call on one worker in wire arrival order.
+ * Incoming frame/queue ownership must be charged by the transport before parsing.
+ */
+public final class DhAssembly implements AutoCloseable {
+    public record Expired(List<Integer> buffers, List<Integer> requests) {}
+    private record RequestOwner(DhPosition position, long started) {}
+    private record Part(byte[] bytes, DhMemoryBudget.Lease lease) {}
+    private static final class Buffer {
+        final long started;
+        long progress;
+        int size;
+        final List<Part> parts = new ArrayList<>();
+        Buffer(long now) { started = now; progress = now; }
+        void close() { parts.forEach(p -> p.lease.close()); parts.clear(); }
+    }
+    private final DhLimits limits;
+    private final DhMemoryBudget budget;
+    private final LongSupplier clock;
+    private final Map<Integer, RequestOwner> requests = new HashMap<>();
+    private final Map<Integer, Buffer> buffers = new HashMap<>();
+    private boolean closed;
+
+    public DhAssembly(DhLimits limits, DhMemoryBudget budget) { this(limits, budget, System::nanoTime); }
+    public DhAssembly(DhLimits limits, DhMemoryBudget budget, LongSupplier clock) {
+        this.limits = Objects.requireNonNull(limits); this.budget = Objects.requireNonNull(budget);
+        this.clock = Objects.requireNonNull(clock);
+    }
+    public void expect(int requestId, DhPosition position) throws DhCodecException {
+        open();
+        if (position.detail() != 6) throw new DhCodecException(DhCodecException.Kind.UNSUPPORTED, "Only detail-6 acquisition is supported");
+        if (requests.containsKey(requestId)) throw unowned("Duplicate DH request owner");
+        if (requests.size() >= limits.buffers()) throw DhInput.limit("Too many outstanding DH requests");
+        requests.put(requestId, new RequestOwner(position, clock.getAsLong()));
+    }
+    public void accept(Split split) throws DhCodecException {
+        open();
+        long now = clock.getAsLong();
+        Buffer buffer = buffers.get(split.bufferId());
+        if (split.first()) {
+            if (buffer != null) throw unowned("Duplicate first DH fragment");
+            if (requests.isEmpty()) throw unowned("DH fragments without a request owner");
+            if (buffers.size() >= limits.buffers()) throw DhInput.limit("Too many incomplete DH buffers");
+            buffer = new Buffer(now);
+        } else if (buffer == null) throw unowned("Missing first DH fragment");
+        if (now - buffer.started >= limits.lifetimeNanos() || now - buffer.progress >= limits.idleNanos()) {
+            buffers.remove(split.bufferId()); buffer.close();
+            throw new DhCodecException(DhCodecException.Kind.EXPIRED, "DH assembly deadline exceeded");
+        }
+        if (split.length() < 1 || split.length() > limits.frameBytes() - 13
+                || split.length() > limits.tileBytes() - buffer.size)
+            throw DhInput.limit("DH assembly exceeds fragment/tile limit");
+        // Bound object overhead even if a peer sends one byte in each frame.
+        if (buffer.parts.size() >= 4096) throw DhInput.limit("Too many DH fragments in one tile");
+        var lease = budget.reserve(split.length() + 160L);
+        try { buffer.parts.add(new Part(split.contents().clone(), lease)); }
+        catch (RuntimeException | Error e) { lease.close(); throw e; }
+        buffer.size += split.length(); buffer.progress = now;
+        buffers.put(split.bufferId(), buffer);
+    }
+    /** A null result means a genuine absent/unchanged response; it never invents a terrain receipt. */
+    public Completed response(Response response) throws DhCodecException {
+        open();
+        RequestOwner owner = requests.get(response.requestId());
+        if (owner == null) throw unowned("Unmatched DH response");
+        if (clock.getAsLong() - owner.started >= limits.lifetimeNanos()) {
+            requests.remove(response.requestId());
+            throw new DhCodecException(DhCodecException.Kind.EXPIRED, "DH request deadline exceeded");
+        }
+        if (response.bufferId() == null) {
+            if (!response.beacons().isEmpty()) throw DhInput.malformed("Beacons without DH payload");
+            requests.remove(response.requestId());
+            return null;
+        }
+        Buffer buffer = buffers.get(response.bufferId());
+        if (buffer == null) throw unowned("DH response references a missing buffer");
+        long now = clock.getAsLong();
+        if (now - buffer.started >= limits.lifetimeNanos() || now - buffer.progress >= limits.idleNanos()) {
+            buffers.remove(response.bufferId()); buffer.close(); requests.remove(response.requestId());
+            throw new DhCodecException(DhCodecException.Kind.EXPIRED, "DH assembly deadline exceeded");
+        }
+        // Joining needs both retained fragments AND the contiguous result at once.
+        var lease = budget.reserve(buffer.size + 64L);
+        try {
+            byte[] data = new byte[buffer.size];
+            int offset = 0;
+            for (Part part : buffer.parts) {
+                System.arraycopy(part.bytes, 0, data, offset, part.bytes.length);
+                offset += part.bytes.length;
+            }
+            buffers.remove(response.bufferId()); buffer.close(); requests.remove(response.requestId());
+            return new Completed(owner.position, data, lease);
+        } catch (RuntimeException | Error e) { lease.close(); throw e; }
+    }
+    public void cancel(int requestId) { requests.remove(requestId); }
+    /** The fragment format has no request ID: cancel cannot identify/release a partially owned buffer.
+     * It remains bounded until expiry or whole-session close.
+     */
+    public Expired expire() {
+        long now = clock.getAsLong();
+        var expiredBuffers = new ArrayList<Integer>();
+        var expiredRequests = new ArrayList<Integer>();
+        buffers.entrySet().removeIf(e -> {
+            Buffer value = e.getValue();
+            boolean expired = now - value.started >= limits.lifetimeNanos() || now - value.progress >= limits.idleNanos();
+            if (expired) { expiredBuffers.add(e.getKey()); value.close(); }
+            return expired;
+        });
+        requests.entrySet().removeIf(e -> {
+            boolean expired = now - e.getValue().started >= limits.lifetimeNanos();
+            if (expired) expiredRequests.add(e.getKey());
+            return expired;
+        });
+        return new Expired(List.copyOf(expiredBuffers), List.copyOf(expiredRequests));
+    }
+    public int incompleteBuffers() { return buffers.size(); }
+    public long assembledBytes() { return buffers.values().stream().mapToLong(b -> b.size).sum(); }
+    private void open() { if (closed) throw new IllegalStateException("DH assembly retired"); }
+    private static DhCodecException unowned(String message) { return new DhCodecException(DhCodecException.Kind.UNOWNED, message); }
+    @Override public void close() { closed = true; buffers.values().forEach(Buffer::close); buffers.clear(); requests.clear(); }
+
+    /** Ownership survives assembler retirement until this result is closed. No raw array escapes. */
+    public final class Completed implements AutoCloseable {
+        private final DhPosition position;
+        private final DhMemoryBudget.Lease lease;
+        private byte[] data;
+        private Completed(DhPosition position, byte[] data, DhMemoryBudget.Lease lease) {
+            this.position = position; this.data = data; this.lease = lease;
+        }
+        public int bytes() { if (data == null) throw new IllegalStateException("DH result released"); return data.length; }
+        public DhTerrainTile decode(DhTerrainDecoder decoder, DhProfile profile, DhTerrainTile.WorldShape world) throws DhCodecException {
+            if (data == null) throw new IllegalStateException("DH result released");
+            return decoder.decode(data, profile, position, world, budget);
+        }
+        @Override public void close() { data = null; lease.close(); }
+    }
+}
diff --git a/common/src/main/java/dev/vox/lss/common/dh/DhCodecException.java b/common/src/main/java/dev/vox/lss/common/dh/DhCodecException.java
new file mode 100644
index 00000000..d9446408
--- /dev/null
+++ b/common/src/main/java/dev/vox/lss/common/dh/DhCodecException.java
@@ -0,0 +1,13 @@
+package dev.vox.lss.common.dh;
+
+import java.io.IOException;
+
+/** Contained codec failures; callers decide session policy without inspecting payload text. */
+public final class DhCodecException extends IOException {
+    public enum Kind { MALFORMED, UNSUPPORTED, RESOURCE_LIMIT, PROTOCOL_MISMATCH, UNOWNED, EXPIRED }
+    private final Kind kind;
+
+    public DhCodecException(Kind kind, String message) { super(message); this.kind = kind; }
+    public DhCodecException(Kind kind, String message, Throwable cause) { super(message, cause); this.kind = kind; }
+    public Kind kind() { return kind; }
+}
diff --git a/common/src/main/java/dev/vox/lss/common/dh/DhInput.java b/common/src/main/java/dev/vox/lss/common/dh/DhInput.java
new file mode 100644
index 00000000..292d0f13
--- /dev/null
+++ b/common/src/main/java/dev/vox/lss/common/dh/DhInput.java
@@ -0,0 +1,71 @@
+package dev.vox.lss.common.dh;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+
+/** Small big-endian cursor. Every variable-length read is checked before copying. */
+final class DhInput {
+    final byte[] bytes;
+    int offset;
+    final int end;
+    DhInput(byte[] bytes) { this(bytes, 0, bytes.length); }
+    DhInput(byte[] bytes, int start, int length) { this.bytes = bytes; offset = start; end = start + length; }
+    int remaining() { return end - offset; }
+    void require(int count) throws DhCodecException {
+        if (count < 0 || count > remaining()) throw malformed("Truncated DH field");
+    }
+    int u8() throws DhCodecException { require(1); return bytes[offset++] & 255; }
+    boolean bool() throws DhCodecException {
+        int value = u8();
+        if (value > 1) throw malformed("Invalid boolean");
+        return value == 1;
+    }
+    int u16() throws DhCodecException { return (u8() << 8) | u8(); }
+    int i32() throws DhCodecException { return (u16() << 16) | u16(); }
+    long i64() throws DhCodecException { return ((long) i32() << 32) | (i32() & 0xffffffffL); }
+    byte[] take(int count) throws DhCodecException {
+        require(count);
+        byte[] result = java.util.Arrays.copyOfRange(bytes, offset, offset + count);
+        offset += count;
+        return result;
+    }
+    void exhausted() throws DhCodecException {
+        if (remaining() != 0) throw malformed("Trailing DH bytes");
+    }
+    String string(DhProfile profile, int limit) throws DhCodecException {
+        int units = u16(), size = units;
+        if (units > limit) throw limit("DH string exceeds limit");
+        if (profile.support()) {
+            // Count validated Unicode scalar values in UTF-16 units, without consuming
+            // a following field or splitting the two units of a supplementary character.
+            int cursor = offset, chars = 0;
+            while (chars < units) {
+                if (cursor >= end) throw malformed("Truncated UTF-8 string");
+                int first = bytes[cursor] & 255;
+                int width = first < 0x80 ? 1 : first >= 0xc2 && first <= 0xdf ? 2
+                        : first >= 0xe0 && first <= 0xef ? 3 : first >= 0xf0 && first <= 0xf4 ? 4 : 0;
+                if (width == 0 || width > end - cursor) throw malformed("Invalid UTF-8 string");
+                chars += width == 4 ? 2 : 1;
+                cursor += width;
+                if (cursor - offset > limit) throw limit("DH string exceeds byte limit");
+            }
+            if (chars != units) throw malformed("UTF-16 prefix splits a surrogate pair");
+            size = cursor - offset;
+        }
+        require(size);
+        try {
+            String result = StandardCharsets.UTF_8.newDecoder().onMalformedInput(CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(CodingErrorAction.REPORT).decode(ByteBuffer.wrap(bytes, offset, size)).toString();
+            offset += size;
+            return result;
+        } catch (CharacterCodingException e) { throw malformed("Invalid UTF-8 string"); }
+    }
+    static DhCodecException malformed(String message) {
+        return new DhCodecException(DhCodecException.Kind.MALFORMED, message);
+    }
+    static DhCodecException limit(String message) {
+        return new DhCodecException(DhCodecException.Kind.RESOURCE_LIMIT, message);
+    }
+}
